# GitHub personal access token (recommended for higher API rate limits)
# Create at: https://github.com/settings/tokens
# Required scopes: (none — public repo access only)
GITHUB_TOKEN=

# Optional: Semantic Scholar API key for research scanning
S2_API_KEY=

# Optional: Anthropic Admin API key (sk-ant-admin-...) for the Claude API
# Usage panel and MCP `get_anthropic_usage` tool. Create at:
# https://console.anthropic.com/settings/admin-keys
# Without this, the usage panel renders a "not configured" placeholder.
ANTHROPIC_ADMIN_API_KEY=
