{
  "name": "canary",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "mcp:build": "esbuild mcp/server.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=mcp/dist/server.mjs --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\" --alias:@=.",
    "mcp:smoke": "npm run mcp:build && node scripts/mcp-smoke.mjs",
    "mcp": "npm run mcp:build && node mcp/dist/server.mjs",
    "pl:scan": "tsx experiments/src/push-leakage/cli.ts ${CANARY_SCAN_ROOT:-$HOME/IdeaProjects} --filter=${CANARY_SCAN_FILTER:-IdeaProjects}",
    "pl:scan:post": "tsx experiments/src/push-leakage/cli.ts ${CANARY_SCAN_ROOT:-$HOME/IdeaProjects} --filter=${CANARY_SCAN_FILTER:-IdeaProjects} --out=experiments/results/push-leakage-$(date +%Y-%m-%d)-post-intervention.json",
    "pl:install-hooks": "node scripts/canary-install-hooks.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^1.7.0",
    "next": "16.2.10",
    "octokit": "^5.0.5",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "recharts": "^3.8.1",
    "shadcn": "^4.1.1",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^6",
    "vitest": "^4.1.2"
  },
  "overrides": {
    "next": {
      "postcss": ">=8.5.10"
    }
  }
}